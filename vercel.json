{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/programmes.html", "destination": "/programmes", "permanent": true },
    { "source": "/admissions.html", "destination": "/admissions", "permanent": true },
    { "source": "/results.html", "destination": "/results", "permanent": true },
    { "source": "/scholarships.html", "destination": "/scholarships", "permanent": true },
    { "source": "/resources.html", "destination": "/resources", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
